# Generate installation-specific configuration with npm run init.
# This reference lists non-secret defaults; credentials have no shared defaults.
DASHBOARD_PUBLIC_ORIGIN=https://localhost:3444
CINDERTRACE_API_URL=https://api:4101
SECURITY_DISPATCH_ENABLED=false
SECURITY_APPROVAL_MODE=console
SECURITY_FUSION_UDP_ENABLED=false
TAILSCALE_LOCAL_ENABLED=false
# Optional: MAGNUS_CONSOLE_URL, MAGNUS_INVENTORY_URL, MAGNUS_INVENTORY_TOKEN
# Optional response: MAGNUS_RESPONSE_URL, MAGNUS_RESPONSE_SECRET
# Optional Hive login: HIVE_OAUTH_DISCOVERY_URL, HIVE_OAUTH_CLIENT_ID,
# HIVE_OAUTH_ISSUER, HIVE_OAUTH_API_AUDIENCE
# Optional exports: HIVE_IAM_SECURITY_URL, HIVE_IAM_SECURITY_CLIENT_ID,
# HIVE_IAM_SECURITY_CLIENT_SECRET, HIVE_SECURITY_EXPORT_URL
# Disposable lab: initialize a fresh separate checkout with npm run init -- --lab.
# Lab initialization uses port 3445, a dedicated project/database, and no integrations.
# Optional server-side lab agent control digest: SECURITY_PLUGIN_LAB_CONTROL_TOKEN_SHA256
