{
  "name": "cindertrace",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @cindertrace/contracts -w @cindertrace/integrations -w @cindertrace/api -w @cindertrace/collector -w @cindertrace/console",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/*.test.mjs",
    "db:generate": "npm run db:generate -w @cindertrace/api",
    "db:migrate": "npm run db:migrate:deploy -w @cindertrace/api",
    "init": "node scripts/init.mjs",
    "check:private": "node scripts/check-private.mjs",
    "scan:secrets": "node scripts/check-private.mjs --secrets",
    "verify": "npm run build && npm run typecheck && npm run tools:check && npm test && npm run openapi:check && npm run check:private",
    "openapi:check": "node scripts/check-openapi.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:core": "node scripts/core-integration.mjs",
    "test:recovery": "node scripts/recovery-integration.mjs",
    "demo": "node scripts/demo.mjs",
    "upgrade": "node scripts/upgrade.mjs",
    "release:bundle": "node scripts/bundle-runtime.mjs",
    "test:upgrade": "CINDERTRACE_UPGRADE_TEST_CONFIRM=disposable-installation node scripts/upgrade-integration.mjs",
    "tools:check": "node scripts/check-tool-identifiers.mjs",
    "lab": "node scripts/lab.mjs",
    "test:lab": "node scripts/lab-integration.mjs",
    "test:lab:browser": "node scripts/lab-browser.mjs",
    "test:browser-auth": "node scripts/browser-auth-integration.mjs",
    "test:response": "node scripts/response-integration.mjs",
    "contracts:browser": "node scripts/export-browser-contracts.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "fast-uri": "3.1.9",
    "postcss": {
      ".": "8.5.32",
      "nanoid": "3.3.18"
    }
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
